# Per-machine Docker Compose overrides.
# Copy to `.env` (gitignored) on machines that need these values.
# Compose auto-reads `.env` from this directory; docker-compose.override.yml
# interpolates the vars below.

# --- Apple Silicon / arm64 (macOS) ONLY ---
# Point ubuntuweb83 at the locally-built NATIVE arm64 image so it runs without
# Rosetta emulation. Build it first (see ARM64-BUILD.md).
# Leave this UNSET on Linux/amd64 — the override falls back to the amd64
# -latest tag automatically.
WEB83_IMAGE=orangehrm/dev-environment:ubuntu24.04-php8.3-latest-arm64
